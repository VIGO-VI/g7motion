# GameSir USB access for --probe and for a non-root daemon.
SUBSYSTEM=="usb", ATTR{idVendor}=="3537", TAG+="uaccess"

# /dev/uhid is normally root-only.  uaccess lets the logged-in seat user
# create the virtual DualShock 4 without running the daemon as root.
KERNEL=="uhid", TAG+="uaccess", MODE="0660"

# The virtual DS4 created via /dev/uhid must be visible to the desktop user
# (SDL3, Steam, Eden, ScarletNX).  Match only uhid-created DS4 v1 devices.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", DEVPATH=="/devices/virtual/misc/uhid/0003:054C:05C4.*", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", DEVPATH=="/devices/virtual/misc/uhid/0003:054C:05C4.*", MODE="0666", TAG+="uaccess"
